# 🎙️ Audio-to-Text Service (Vercel Stateless)
# Simple audio transcription using OpenAI Whisper

# 1. Get OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# 2. Get Twilio credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_SENDER_NUMBER=whatsapp:+14155238886

# Vercel deployment settings
VERIFY_TWILIO_SIGNATURE=false
ENABLE_RATE_LIMITING=false  # In-memory rate limiting doesn't work well with serverless

# Optional: Rate limiting (only effective on traditional servers like Render)
# MAX_REQUESTS_PER_HOUR=20

# Vercel webhook: https://your-app.vercel.app/webhook/whatsapp
